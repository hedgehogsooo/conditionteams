acceleration_and_braking --
motion_control -> signal_system : Управляющие команды
signal_system ++ 
signal_system -> signal_system: Выполнение управляющий команд 
signal_system --

motion_control -> spr ++: Корректировка управляющих команд
spr -> data : Запрос данных окружающей среды т/с

camers -> data : Данные с камер 
camers++
camers--
lidar -> data : Данные с лидара 
lidar++
lidar--
ir_sensor -> data : Данные с ИК-датчиков 
ir_sensor++
ir_sensor--

data --
data -> spr : Данные окружающей среды т/с
spr -> spr : Расчет управляющих команд 
spr -> motion_control : Скорректированные управляющие команды
spr--

navigation_gnss -> komplex : Текущие координаты(GNSS)
navigation_ins -> komplex : Текущие координаты(ИНС)
komplex -> komplex : Комплексирование
komplex -> emergency_bloc : Координаты
motion_control -> orkestr : В случае аварийной обстановки
motion_control --
orkestr -> emergency_bloc : Аварийная обстановка
emergency_bloc -> reduction_speed : Аварийное снижение скорости

motion_control -> taxiing : Управляющие команды
motion_control ++
taxiing ++
