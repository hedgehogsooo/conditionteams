taxiing --
system_taxiing ++
system_taxiing -> system_taxiing : Выполнение управляющих команд
system_taxiing --
motion_control -> engine_management : Управляющие команды
engine_management ++
engine_management -> acceleration_and_braking : Управляющие команды
engine_management --
acceleration_and_braking ++ 
acceleration_and_braking -> acceleration_and_braking : Выполнение управляющих команд
acceleration_and_braking --
motion_control -> signal_system : Управляющие команды
signal_system ++ 
signal_system -> signal_system: Выполнение управляющий команд 
signal_system --

navigation_gnss -> komplex : Текущие координаты(GNSS)
navigation_ins -> komplex : Текущие координаты(ИНС)
komplex -> komplex : Комплексирование
komplex -> emergency_bloc : Координатыs
komplex -> planing_navigation : Координатыs
planing_navigation -> planing_navigation : Проверка прибытия в контрольную точку
planing_navigation -> orkestr : Прибытие в контрольную точку

end

group Груз 
monitor_gryz -> monitor_gryz : Проверка загруженности 
monitor_gryz -> emergency_bloc : Груз загружен/разгружен
orkestr -> orkestr : Проверка выполнения маршрутного листа
end

